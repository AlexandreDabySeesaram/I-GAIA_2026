  "cells": [
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: GreedyconvergenceSVK\n",
        "#| fig-cap: Loss convergence\n",
        "# \n",
        "import plotly.graph_objects as go\n",
        "import pandas as pd\n",
        "\n",
        "# Load the CSV data\n",
        "# Loss_gap = (loss - L_ref) / |L_ref|, with L_ref = -52.20 slightly below the lowest loss reached by any run\n",
        "try:\n",
        "    data = pd.read_csv(\"SVK_lung_6D_greedy.csv\")\n",
        "except:\n",
        "    data = pd.read_csv(\"Figures/SVK_lung_6D_greedy.csv\")\n",
        "# Extract data\n",
        "epochs = data['epochs']\n",
        "gap = data['Loss_gap']\n",
        "modes = data['Modes']\n",
        "\n",
        "# Create the figure\n",
        "fig = go.Figure()\n",
        "\n",
        "# Add Loss gap trace\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=epochs, y=gap,\n",
        "    name='Loss gap',\n",
        "    yaxis='y1',\n",
        "    mode='lines',\n",
        "    line=dict(color='#170f38')\n",
        "))\n",
        "\n",
        "# Add Modes trace\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=epochs, y=modes,\n",
        "    visible='legendonly',\n",
        "    name='Modes',\n",
        "    yaxis='y2',\n",
        "    mode='lines',\n",
        "    line=dict(color='#3a46f5', shape='hv')\n",
        "))\n",
        "\n",
        "# Update layout\n",
        "fig.update_layout(\n",
        "    plot_bgcolor='rgba(0,0,0,0)',  # Remove background color\n",
        "    width=560, \n",
        "    height=400,  \n",
        "    xaxis=dict(title='Iterations (L-BFGS)',\n",
        "        showgrid=True,\n",
        "        gridcolor='lightgray'),\n",
        "    yaxis=dict(\n",
        "        title=dict(\n",
        "            text='Relative loss gap', \n",
        "            font=dict(color='#170f38')),\n",
        "        type='log',\n",
        "        tickvals=[1e-3, 1e-2, 1e-1, 1],\n",
        "        ticktext=['10⁻³', '10⁻²', '10⁻¹', '1'],\n",
        "        tickfont=dict(color='#170f38'),\n",
        "        showgrid=True,\n",
        "        gridcolor='lightgray'\n",
        "    ),\n",
        "    yaxis2=dict(\n",
        "        title=dict(\n",
        "            text='Modes', \n",
        "            font=dict(color='#3a46f5')),\n",
        "        overlaying='y',\n",
        "        side='right',\n",
        "        range=[0, 15],\n",
        "        tickvals=[1, 2, 4, 6, 8, 10, 12, 14],\n",
        "        tickfont=dict(color='#3a46f5')\n",
        "        \n",
        "    ),\n",
        "    legend=dict(x=1.12, y=0.9)\n",
        "    \n",
        ")\n",
        "\n",
        "# Show the figure\n",
        "fig.show()"
      ],
      "id": "GreedyconvergenceSVK",
      "execution_count": null,
      "outputs": []
    }
  ],
