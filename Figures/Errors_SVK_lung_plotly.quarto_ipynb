      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: ErrorsSVK\n",
        "#| fig-cap: Relative error with regards to FEniCS (SVK)\n",
        "\n",
        "import plotly.graph_objects as go\n",
        "import pandas as pd\n",
        "\n",
        "# Relative nodal L2 errors against FEniCS SVK at 8 parameter sets outside the training grid\n",
        "# NN-PGD: 12 greedy linear modes, then greedy SVK enrichment up to 20 modes (lowest error)\n",
        "try:\n",
        "    data = pd.read_csv(\"SVK_lung_6D_errors.csv\")\n",
        "except:\n",
        "    data = pd.read_csv(\"Figures/SVK_lung_6D_errors.csv\")\n",
        "\n",
        "hover = ('E = %{customdata[0]:.2f} kPa<br>θ = %{customdata[1]:.2f}, φ = %{customdata[2]:.2f}<br>'\n",
        "         'p₀ = %{customdata[3]:.2f} kPa<br>H = %{customdata[4]:.2f}, K = %{customdata[5]:.2f} Pa/mm<br>'\n",
        "         'error = %{y:.1f} %<extra></extra>')\n",
        "cd = data[['E_kPa', 'theta', 'phi', 'p0_kPa', 'H_Pa_mm', 'K_Pa_mm']].values\n",
        "\n",
        "fig = go.Figure()\n",
        "fig.add_trace(go.Bar(\n",
        "    x=data['Point'], y=100 * data['NNPGD_error'],\n",
        "    name='NN-PGD (SVK)',\n",
        "    marker=dict(color='#3a46f5'),\n",
        "    customdata=cd, hovertemplate=hover\n",
        "))\n",
        "fig.add_trace(go.Bar(\n",
        "    x=data['Point'], y=100 * data['Linear_FEM_error'],\n",
        "    name='Linear FEM',\n",
        "    marker=dict(color='rgba(23, 15, 56, 0.35)'),\n",
        "    customdata=cd, hovertemplate=hover\n",
        "))\n",
        "\n",
        "fig.update_layout(\n",
        "    plot_bgcolor='rgba(0,0,0,0)',  # Remove background color\n",
        "    width=450, \n",
        "    height=400,  \n",
        "    barmode='group',\n",
        "    xaxis=dict(title='Test parameter set',\n",
        "               tickvals=list(range(1, 9)),\n",
        "               showgrid=False),\n",
        "    yaxis=dict(\n",
        "        title=dict(\n",
        "            text='Relative L² error (%)', \n",
        "            font=dict(color='#170f38')),\n",
        "        tickfont=dict(color='#170f38'),\n",
        "        showgrid=True,\n",
        "        gridcolor='lightgray'\n",
        "    ),\n",
        "    legend=dict(x=0.02, y=1.0)\n",
        ")\n",
        "\n",
        "# Show the figure\n",
        "fig.show()"
      ],
      "id": "ErrorsSVK",
      "execution_count": null,
      "outputs": []
    }
  ],
